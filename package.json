{
  "name": "@jgb-solutions/kit",
  "version": "0.3.0",
  "description": "One package for JGB Solutions apps, in tree-shakable namespaces: Cloudflare Access, Better Auth (kit/access, kit/auth\u2026) and the admin panel kit (kit/admin, React 19). An app bundles only the subpaths it imports.",
  "license": "MIT",
  "author": "JGB Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgb-solutions/kit.git"
  },
  "homepage": "https://github.com/jgb-solutions/kit#readme",
  "bugs": "https://github.com/jgb-solutions/kit/issues",
  "keywords": [
    "cloudflare-access",
    "jwt",
    "jose",
    "bun",
    "cloudflare-workers",
    "better-auth",
    "passkeys",
    "orpc",
    "expo",
    "admin",
    "dashboard",
    "react",
    "design-system",
    "accessible"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./access": {
      "types": "./dist/access.d.ts",
      "import": "./dist/access.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./auth/bun": {
      "types": "./dist/auth/bun.d.ts",
      "import": "./dist/auth/bun.js"
    },
    "./auth/orpc": {
      "types": "./dist/auth/orpc.d.ts",
      "import": "./dist/auth/orpc.js"
    },
    "./auth/rules": {
      "types": "./dist/auth/rules.d.ts",
      "import": "./dist/auth/rules.js"
    },
    "./auth/expo": {
      "types": "./dist/auth/expo.d.ts",
      "import": "./dist/auth/expo.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./admin/styles.css": "./dist/admin/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun check",
    "test": "bun test src",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "check:package": "bun scripts/check-package.ts",
    "prepublishOnly": "bun run build && bun run check:package",
    "check:install": "bun scripts/check-install.ts",
    "test:e2e": "bun --bun playwright test",
    "playground": "bun playground/serve.ts",
    "screenshots": "bun --bun playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "jose": "6.2.18"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.22 <2",
    "@better-auth/passkey": ">=1.7.22 <2",
    "@orpc/server": ">=2.0.0-beta.52 <3",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "@better-auth/passkey": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@better-auth/passkey": "1.7.27",
    "@orpc/server": "2.0.0-beta.52",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
