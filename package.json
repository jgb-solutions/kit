{
  "name": "@jgb-solutions/kit",
  "version": "0.1.1",
  "description": "Generic plumbing for web apps on Bun and Cloudflare Workers: small, typed, tree-shakable modules.",
  "license": "MIT",
  "author": "JGB Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgb-solutions/kit.git"
  },
  "homepage": "https://github.com/jgb-solutions/kit#readme",
  "bugs": "https://github.com/jgb-solutions/kit/issues",
  "keywords": [
    "cloudflare-access",
    "jwt",
    "jose",
    "bun",
    "cloudflare-workers"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./access": {
      "types": "./dist/access.d.ts",
      "import": "./dist/access.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "check:package": "bun scripts/check-package.ts",
    "prepublishOnly": "bun run build && bun run check:package"
  },
  "dependencies": {
    "jose": "6.2.18"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "6.0.3"
  }
}
